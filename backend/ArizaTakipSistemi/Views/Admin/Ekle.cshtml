@model Ariza
@{
    ViewData["Title"] = "Yeni Kayıt Ekle";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h5 class="mb-0">Yeni Kayıt Ekle (Manuel)</h5>
    <a asp-action="Index" class="btn btn-ghost btn-sm">← Listeye Dön</a>
</div>

<div class="panel p-4" style="max-width:640px;">
    <p class="text-muted-sm mb-3">Kameranın kaçırdığı ya da personelin sahada gözlemlediği bir arızayı buradan elle kaydedebilirsin.</p>

    <form method="post" asp-action="Ekle" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label-sm">Fotoğraf (opsiyonel)</label>
            <input type="file" name="fotografDosyasi" accept="image/*" class="form-control" />
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="form-label-sm">Arıza Türü</label>
                <select name="ArizaTuru" class="form-select">
                    @foreach (var t in Enum.GetValues<ArizaTuru>())
                    {
                        <option value="@t">@t</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label-sm">Durum</label>
                <select name="Durum" class="form-select">
                    @foreach (var d in Enum.GetValues<ArizaDurumu>())
                    {
                        <option value="@d" selected="@(d == ArizaDurumu.Bekliyor)">@d</option>
                    }
                </select>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="form-label-sm">Şiddet</label>
                <select name="Siddet" class="form-select">
                    <option value="">— (yok)</option>
                    @foreach (var s in Enum.GetValues<ArizaSiddeti>())
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label-sm">Güven Skoru (0-1, opsiyonel)</label>
                <input type="number" name="GuvenSkoru" step="0.01" min="0" max="1" class="form-control" placeholder="Manuel kayıt için boş bırakılabilir" />
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="form-label-sm">Enlem</label>
                <input type="number" name="Enlem" step="0.000001" class="form-control" placeholder="41.0082" />
            </div>
            <div class="col-md-6">
                <label class="form-label-sm">Boylam</label>
                <input type="number" name="Boylam" step="0.000001" class="form-control" placeholder="28.9784" />
            </div>
        </div>

        <div class="mb-4">
            <label class="form-label-sm">Tespit Zamanı</label>
            <input type="datetime-local" name="TespitZamani" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" class="form-control" />
        </div>

        <button type="submit" class="btn btn-accent px-4">Kaydı Ekle</button>
        <a asp-action="Index" class="btn btn-ghost">Vazgeç</a>
    </form>
</div>
